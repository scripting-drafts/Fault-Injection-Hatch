[Unit]
Description=Retire the faulty physical core at boot (LAB is session-only)
Documentation=https://github.com/scripting-drafts/Fault-Injection-Hatch#readme
After=sysinit.target
Before=systemd-user-sessions.service
ConditionPathExists=/etc/faultlab/config

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/faultlab-mode retired

[Install]
WantedBy=multi-user.target
