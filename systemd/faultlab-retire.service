[Unit]
Description=Retire the faulty physical core
Documentation=https://github.com/scripting-drafts/Fault-Injection-Hatch#readme
After=sysinit.target
ConditionPathExists=/etc/faultlab/mode

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/bin/sh -c 'grep -qx retired /etc/faultlab/mode'
ExecStart=/usr/local/sbin/faultlab-retire

[Install]
WantedBy=multi-user.target
