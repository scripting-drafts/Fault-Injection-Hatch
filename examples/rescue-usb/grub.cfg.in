set timeout=15
set default=0

@ENTRIES@

menuentry "Root shell (init=/bin/bash)" {
    insmod part_msdos
    insmod part_gpt
    insmod fat
    insmod ext2
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    linux /boot/vmlinuz-@DEFAULT_KERNEL@ root=UUID=@ROOT_UUID@ rw init=/bin/bash
    initrd /boot/initrd.img-@DEFAULT_KERNEL@
}
