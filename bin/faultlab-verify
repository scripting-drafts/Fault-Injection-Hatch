#!/usr/bin/env bash
# Verify that isolation is active and that core 2 is actually fenced off.
set -uo pipefail
pass=0; warn=0; fail=0
ok()   { printf 'PASS  %s\n' "$*"; pass=$((pass + 1)); }
note() { printf 'WARN  %s\n' "$*"; warn=$((warn + 1)); }
bad()  { printf 'FAIL  %s\n' "$*"; fail=$((fail + 1)); }
readfile() { cat "$1" 2>/dev/null || true; }

cpu_in_list() {
    local want=$1 list=$2 part a b
    [[ $list =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || return 1
    local IFS=,
    for part in $list; do
        if [[ $part == *-* ]]; then
            a=${part%-*}; b=${part#*-}
            (( want >= a && want <= b )) && return 0
        else
            (( want == part )) && return 0
        fi
    done
    return 1
}

cmdline=$(readfile /proc/cmdline)
echo "cmdline: $cmdline"
for token in isolcpus nohz_full rcu_nocbs irqaffinity; do
    if grep -qE "(^| )$token=" <<<"$cmdline"; then ok "$token present"; else bad "$token missing"; fi
done

isolated=$(readfile /sys/devices/system/cpu/isolated)
nohz=$(readfile /sys/devices/system/cpu/nohz_full)
for cpu in 2 8; do
    cpu_in_list "$cpu" "$isolated" && ok "CPU$cpu isolated" || bad "CPU$cpu not isolated"
    cpu_in_list "$cpu" "$nohz" && ok "CPU$cpu in nohz_full" || bad "CPU$cpu not in nohz_full"
done

for slice in system.slice user.slice; do
    configured=$(readfile "/sys/fs/cgroup/$slice/cpuset.cpus")
    effective=$(readfile "/sys/fs/cgroup/$slice/cpuset.cpus.effective")
    echo "$slice: cpus='$configured' effective='$effective'"
    if [[ -z $configured ]]; then
        bad "$slice is unrestricted (inherits all CPUs, incl. core 2)"
    elif cpu_in_list 2 "$configured" || cpu_in_list 8 "$configured"; then
        bad "$slice can still place work on core 2"
    else
        ok "$slice fenced off core 2"
    fi
done

lab=$(readfile /sys/fs/cgroup/faultlab.slice/cpuset.cpus)
if [[ -n $lab ]] && cpu_in_list 2 "$lab" && cpu_in_list 8 "$lab"; then
    ok "faultlab.slice holds core 2 ('$lab')"
else
    note "faultlab.slice not configured or not started ('$lab')"
fi

for cpu in 2 8; do
    state=$(readfile "/sys/devices/system/cpu/cpu$cpu/online")
    [[ -n $state ]] && echo "CPU$cpu online=$state"
done

echo
echo "--- tasks sampled on CPUs 2/8 ---"
tasks=$(ps -eLo psr=,pid=,comm= 2>/dev/null | awk '$1 == 2 || $1 == 8')
if [[ -z $tasks ]]; then
    ok "no tasks on CPUs 2/8"
else
    user_tasks=$(while read -r psr pid comm; do
        if IFS= read -r -d '' _ < "/proc/$pid/cmdline" 2>/dev/null; then
            printf '%s %s %s\n' "$psr" "$pid" "$comm"
        fi
    done <<<"$tasks")
    if [[ -n $user_tasks ]]; then
        count=$(wc -l <<<"$user_tasks")
        head -10 <<<"$user_tasks"
        [[ $count -gt 10 ]] && echo "... ($count user tasks total)"
        bad "$count user tasks found on the fault core"
    else
        note "only kernel threads remain (RETIRED mode removes them)"
    fi
fi

echo
echo "--- IRQ delta over 3s ---"
header=$(head -1 /proc/interrupts 2>/dev/null)
if ! grep -q 'CPU2' <<<"$header" || ! grep -q 'CPU8' <<<"$header"; then
    note "CPU2/8 offline; IRQ check skipped (offline is the strongest state)"
else
    read -r irq_a irq_b < <(awk '
        NR == 1 { for (i = 2; i <= NF; i++) { if ($i == "CPU2") c2 = i; if ($i == "CPU8") c8 = i } next }
        /^ *[0-9]+:/ { s2 += $c2; s8 += $c8 }
        END { printf "%d %d\n", s2, s8 }
    ' /proc/interrupts)
    sleep 3
    read -r irq_a2 irq_b2 < <(awk '
        NR == 1 { for (i = 2; i <= NF; i++) { if ($i == "CPU2") c2 = i; if ($i == "CPU8") c8 = i } next }
        /^ *[0-9]+:/ { s2 += $c2; s8 += $c8 }
        END { printf "%d %d\n", s2, s8 }
    ' /proc/interrupts)
    d2=$((irq_a2 - irq_a)); d8=$((irq_b2 - irq_b))
    if [[ $d2 -eq 0 && $d8 -eq 0 ]]; then
        ok "no interrupts on CPUs 2/8 in 3s"
    else
        note "interrupt activity on core 2 (CPU2 +$d2, CPU8 +$d8); check IPIs/timers"
    fi
fi

echo
printf 'summary: %d pass, %d warn, %d fail\n' "$pass" "$warn" "$fail"
[[ $fail -eq 0 ]]
